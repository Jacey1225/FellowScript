<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardcoded "development" here is expected to be Xcode's own
	     substitution target: CODE_SIGN_STYLE = Automatic for both the Debug
	     and Release configs of the main target (this is the one shared
	     entitlements file for both), so Xcode normally rewrites this to
	     "production" at archive/export time based on the actual
	     distribution provisioning profile. Not independently verified in
	     this repo (would require inspecting a signed, archived .ipa's
	     embedded entitlements -- ios-guidelines #3, 20260904-frontend-arch-
	     sweep). If push notifications (session-created/reminder pushes,
	     AppState.registerDeviceToken/openSession) silently stop arriving in
	     a shipped build, this is the first thing to check: run
	     `codesign -d --entitlements :- YourApp.app` against the archived
	     .ipa and confirm this key actually reads "production" there. -->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  Task 20260916-callkit-voip-ring: no NEW entitlements-file key is added
	  here for VoIP push/CallKit. Checked deliberately, not assumed: Apple's
	  VoIP-push entitlement surface is a Background Modes capability
	  (Xcode Signing & Capabilities -> Background Modes -> "Voice over IP",
	  which maps to the `voip` UIBackgroundModes entry in Info.plist, not an
	  entitlements dict key) plus the existing `aps-environment` above (a
	  VoIP-type push is authenticated the same token-based-JWT way as any
	  other APNs push -- see push.py's validate_voip_config() docstring for
	  why no second/dedicated credential is needed). CallKit itself
	  (CXProvider/CXCallController) requires no entitlement at all. What
	  DOES need action outside this repo -- enabling the VoIP Services /
	  Background Modes capability for this app's App ID in the Apple
	  Developer Portal if not already on, and the App Review justification
	  for using PushKit's VoIP background mode for this use case -- is this
	  task's security gate's own explicit disclosure deliverable, not
	  resolved or assumed here.
	-->
	<!--
	  Task 20260929-group-invite-links: Universal Links for
	  https://fellowscript.com/join/<token>. Requires (1) the Associated
	  Domains capability enabled on this App ID in the Apple Developer portal
	  and provisioning regenerated (automatic signing normally handles it --
	  verify), and (2) the apple-app-site-association file live at
	  https://fellowscript.com/.well-known/apple-app-site-association (served
	  as application/json, 200, no redirect). See ops/nginx/invite-links.conf.
	  Until both are true the link opens in Safari (the web landing page) and
	  the com.fellowscript.app://join/<token> custom scheme still works.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fellowscript.com</string>
	</array>
	<!--
	  Task 20261009-session-ui-redesign, step 5 (whole-screen sharing): the App
	  Group shared with the FellowScriptBroadcast ReplayKit upload extension
	  (bundle id com.fellowscript.app.BroadcastUpload). The extension writes
	  downscaled frames to a Unix socket inside this group's container and the
	  app forwards them to Chime. Requires the App Group to exist in the Apple
	  Developer portal and be enabled on BOTH App IDs; until then signed
	  (device/archive) builds fail at provisioning, simulator builds with
	  signing off are unaffected. Nothing else is granted to the extension.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.fellowscript.app</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
