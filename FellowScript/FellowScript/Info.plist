<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  ATS scoping decision (recorded 2026-08-17, task 20260817-fix-preexisting-test-failures):
	  NSAllowsLocalNetworking is added to this single shared Info.plist, which is used for
	  both Debug and Release builds (INFOPLIST_FILE = FellowScript/Info.plist for both
	  configurations in project.pbxproj) -- meaning it ships in the production build too.
	  This is a deliberate choice, not an oversight: NSAllowsLocalNetworking only exempts
	  loopback/.local/private-range addresses from ATS's TLS requirement and leaves ATS's
	  strict requirements for actual internet hosts fully intact, so it does not broaden the
	  app's exposure to insecure internet traffic. A Debug-only Info.plist/xcconfig split was
	  considered and rejected as disproportionate for this narrow, commonly-shipped exception.
	  Do not broaden this to NSAllowsArbitraryLoads or any internet-host exception.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>FellowScript uses your camera for video calls during study sessions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FellowScript uses your microphone for audio calls during study sessions.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  Ember Glass typography (task 20260827-ember-glass-chat-rewrite): bundles
	  Playfair Display + Inter as real custom fonts, replacing the previous
	  Font.playfair()/Font.lora() builders, which silently resolved to system
	  fonts (SF Pro Rounded / New York) despite their names. Font files live in
	  FellowScript/Fonts/ (picked up automatically by the FellowScript target's
	  file-system-synchronized group; no project.pbxproj edit needed) and are
	  copied to the bundle root by the default Copy Bundle Resources phase, so
	  each entry below is a bare filename, not a path. License check (SIL Open
	  Font License 1.1, verified against the actual font files' OFL.txt, not
	  assumed) is recorded in FellowScript/Fonts/NOTICE.md.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>PlayfairDisplay-Regular.ttf</string>
		<string>PlayfairDisplay-SemiBold.ttf</string>
		<string>PlayfairDisplay-Bold.ttf</string>
		<string>PlayfairDisplay-Italic.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.fellowscript.app</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.667477247503-1hgf50kh24a3gi121u1eps5cptjjufds</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
