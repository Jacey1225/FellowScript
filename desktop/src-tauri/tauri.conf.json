{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FellowScript",
  "version": "0.1.0",
  "identifier": "com.fellowscript.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://fellowscript.com/reader"
  },
  "app": {
    "windows": [
      {
        "title": "FellowScript",
        "url": "https://fellowscript.com/reader",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Jacey Simpson (886XPLVC69)",
      "hardenedRuntime": true
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
