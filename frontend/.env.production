# Deployment-specific value (Configuration Q2) -- the one canonical
# definition of the API base URL for a production build (`npm run build`
# picks this up automatically per Vite's env-file convention). Not a secret;
# safe to commit. See src/config.js.
VITE_API_URL=https://fellowscript.com/api

# Deployment-specific value (Configuration Q2/Q7, task 20260909-website-seo)
# -- the canonical production domain, consumed by src/config.js's SITE_URL
# and used for <link rel="canonical">, Open Graph/Twitter, and JSON-LD tags.
# Required for `npm run build` -- vite.config.js fails the build loudly if
# this is missing (Configuration Q4), rather than shipping a placeholder.
VITE_SITE_URL=https://fellowscript.com
